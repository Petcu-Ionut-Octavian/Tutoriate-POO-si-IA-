/***************************************************
* 8. REFERINTA CONST
***************************************************/

class StudentRef
{
public:

    int varsta;

    StudentRef(int v)
    {
        varsta = v;
    }
};

void afisare(const StudentRef& s)
{
    cout << s.varsta << endl;

    // s.varsta = 30; // EROARE
}

void exempluReferintaConst()
{
    StudentRef s(21);

    afisare(s);
}

/***************************************************
* 9. STATIC LOCAL
***************************************************/

void contor()
{
    static int nr = 0;

    nr++;

    cout << nr << endl;
}

void exempluStaticLocal()
{
    contor();
    contor();
    contor();
}

/***************************************************
* 10. DATA STATICA
***************************************************/

class StudentStatic
{
public:

    static int nrStudenti;

    StudentStatic()
    {
        nrStudenti++;
    }
};

int StudentStatic::nrStudenti = 0;

void exempluDataStatica()
{
    StudentStatic s1;
    StudentStatic s2;
    StudentStatic s3;

    cout << StudentStatic::nrStudenti << endl;
}

