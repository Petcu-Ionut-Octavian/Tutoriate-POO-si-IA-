========================================================*/

class A6 {
public:
    int x = 1;
};

class B6 : public A6 {
};

class C6 : public A6 {
};

class D6 : public B6,
           public C6 {
};

void ex6_fara_virtual() {

    D6 d;

    d.B6::x = 10;
    d.C6::x = 20;

    std::cout
        << d.B6::x
        << ' '
        << d.C6::x
        << '\n';
}

