#include <iostream>

/*========================================================
  EXEMPLUL 1 - PROBLEMA DIAMANTULUI
========================================================*/

class A {
public:
    int x = 10;
};

class B : public A {
};

class C : public A {
};

class D : public B, public C {
};

void ex1_diamond_problem() {

    D d;

    // d.x = 100; // EROARE

    d.B::x = 10;
    d.C::x = 20;

    std::cout << "B::x = "
              << d.B::x
              << '\n';

    std::cout << "C::x = "
              << d.C::x
              << '\n';
}

// ex1_diamond_problem();


/*========================================================
  EXEMPLUL 2 - AMBIGUITATE LA METODE
========================================================*/

class A2 {
public:
    void f() {
        std::cout
            << "A2::f()\n";
    }
};

class B2 : public A2 {
};

class C2 : public A2 {
};

class D2 : public B2,
           public C2 {
};

void ex2_ambiguitate_metode() {

    D2 d;

    // d.f(); // EROARE

    d.B2::f();
    d.C2::f();
}

// ex2_ambiguitate_metode();


